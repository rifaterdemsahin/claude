# ⚠️  NEVER COMMIT REAL VALUES TO GIT
# Copy this file to .env and fill in your secrets via Doppler
# Or use: doppler secrets download --format env > .env

# Claude AI API Configuration
ANTHROPIC_API_KEY=your_claude_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Doppler Project Configuration (optional - for CLI reference)
DOPPLER_PROJECT=delivery-pilot-template
DOPPLER_CONFIG=dev

# Optional: AI Stack (if using Qdrant + Ollama locally)
QDRANT_URL=http://localhost:6333
OLLAMA_URL=http://localhost:11434

# Optional: Fly.io deployment
FLY_API_TOKEN=your_fly_token_here
